              "model": "openai:gpt-4.1-mini-2025-04-14"
            }
          }
        },
        {
          "label": "구동사 (여러 낱말)",
          "request": {
            "assistant_id": "hub",
            "input": {
              "service": "sb",
              "task": "word_example",
              "request_id": "sb-batch-20260812-0002",
              "payload": {
                "english": "put off",
                "meaning": "미루다, 연기하다"
              }
            }
          },
          "response": {
            "output": {
              "english": "put off",
              "example": "We had to put off our meeting until next week.",
              "example_ko": "우리 회의를 다음 주로 미뤘어요.",
              "model": "openai:gpt-4.1-mini-2025-04-14"
            }
          }
        },
        {
          "label": "재생성 (avoid 사용)",
          "request": {
            "assistant_id": "hub",
            "input": {
              "service": "sb",
              "task": "word_example",
              "request_id": "sb-regen-20260812-0003",
              "payload": {
                "english": "prompt",
                "meaning": "신속한, 즉각적인",
                "avoid": [
                  "Thank you for your prompt reply to my email."
                ]
              }
            }
          },
          "response": {
            "output": {
              "english": "prompt",
              "example": "The doctor gave prompt care to the injured man.",
              "example_ko": "의사가 다친 남자에게 즉시 치료를 해 주었어요.",
              "model": "openai:gpt-4.1-mini-2025-04-14"
            }
          },
          "note": "avoid 의 문장과 사실상 같으면(구두점·대소문자 차이 포함) 재생성한다."
        }
      ],
      "quality_gate": {
        "description": "「자연스럽다」는 검증할 수 없다. 셀 수 있는 것만 코드가 강제한다. 위반 시 재생성 1회 -> 그래도 위반이면 run error. 절삭·보정으로 때우지 않는다.",
        "enforced_by_code": [
