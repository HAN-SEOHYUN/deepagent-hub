  "tasks": {
    "ping": {
      "description": "LLM 없이 왕복만 확인한다. 배포 헬스체크용",
      "timeout_s": 5.0,
      "calls_llm": false,
      "request": {
        "assistant_id": "hub",
        "input": {
          "service": "ci",
          "task": "ping",
          "request_id": "deploy-check",
          "payload": {}
        }
      },
      "response": {
        "output": {
          "pong": true
        }
      }
    },
    "word_example": {
      "description": "영어 단어와 뜻을 받아 일상 예문(영어+한글)을 만든다",
      "timeout_s": 45.0,
      "calls_llm": true,
      "model": {
        "env_var": "WORD_EXAMPLE_MODEL",
        "default": "openai:gpt-4.1-mini",
        "current": "openai:gpt-4.1-mini-2025-04-14",
        "note": "init_chat_model 이 openai:/anthropic: 접두사로 프로바이더까지 바꾼다. .env 수정 + 재기동으로 교체 - 코드 변경 없음."
      },
      "request_schema": {
        "description": "입력.\n\n`meaning` 이 필수인 이유: `prompt` 는 「신속한」(형용사)이자 「자극하다」(동사)이자\n「프롬프트」(명사)다. 뜻 없이는 어느 쪽인지 알 수 없고, 단어장에 이미 있으므로 그대로 받는다.",
        "properties": {
          "english": {
            "description": "대상 단어·구문. 원문 그대로",
            "minLength": 1,
            "title": "English",
            "type": "string"
          },
          "meaning": {
            "description": "한글 뜻. 품사를 가르는 근거",
            "minLength": 1,
            "title": "Meaning",
            "type": "string"
          },
          "part_of_speech": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "품사 힌트. 없으면 meaning 으로 추론",
            "title": "Part Of Speech"
          },
          "avoid": {
            "description": "이미 있는 예문들. 재생성에서 같은 문장이 나오면 사용자는 고장으로 여긴다",
            "items": {
              "type": "string"
            },
            "title": "Avoid",
            "type": "array"
          }
        },
        "required": [
          "english",
          "meaning"
        ],
        "title": "WordExampleIn",
        "type": "object"
      },
      "response_schema": {
        "description": "출력.\n\n`english` 를 에코백하는 이유: 호출자가 병렬로 던졌을 때 응답이 뒤섞이면\n조용히 다른 단어에 저장된다. 호출자는 불일치를 감지하면 저장하지 않는다.\n\n`model` 을 돌려주는 이유: 모델은 `.env` 로 바뀐다. 호출자가 화면 문구에\n박아두면 모델을 바꾼 순간 그 문구가 거짓말이 된다.",
        "properties": {
          "english": {
            "description": "요청한 단어 그대로 (에코백)",
            "minLength": 1,
            "title": "English",
            "type": "string"
          },
          "example": {
            "description": "영어 예문 한 문장",
            "minLength": 1,
            "title": "Example",
            "type": "string"
          },
          "example_ko": {
            "description": "자연스러운 한글",
            "minLength": 1,
            "title": "Example Ko",
            "type": "string"
          },
          "model": {
            "description": "실제로 쓴 모델",
            "minLength": 1,
            "title": "Model",
            "type": "string"
          }
        },
        "required": [
          "english",
          "example",
          "example_ko",
          "model"
        ],
        "title": "WordExampleOut",
        "type": "object"
      },
      "examples": [
        {
          "label": "형용사 (기본)",
          "request": {
            "assistant_id": "hub",
            "input": {
              "service": "sb",
              "task": "word_example",
              "request_id": "sb-batch-20260812-0001",
              "payload": {
                "english": "prompt",
                "meaning": "신속한, 즉각적인",
