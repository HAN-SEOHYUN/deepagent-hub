    }
  },
  "envelope": {
    "description": "호출자가 지켜야 할 유일한 규약. 허브는 봉투만 알고 payload 내용은 모른다.",
    "schema": {
      "description": "모든 호출이 이 모양으로 들어온다.\n\n- 네 필드 모두 필수\n- 여분 필드는 무시한다 (확장 규칙: 필드 추가는 선택으로만)\n- 검증 후 불변 - dispatch 도중 변조를 막는다",
      "properties": {
        "service": {
          "description": "누가 부르는가. 기록·정책의 축. 라우팅에는 쓰지 않는다",
          "minLength": 1,
          "title": "Service",
          "type": "string"
        },
        "task": {
          "description": "무엇을 시키는가. 라우팅 키",
          "minLength": 1,
          "title": "Task",
          "type": "string"
        },
        "request_id": {
          "description": "호출자가 만든 추적 ID. 호출자 로그와 대조하는 데 쓴다",
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "description": "그래프별 입력. 허브는 내용을 모른다",
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "service",
        "task",
        "request_id",
        "payload"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "example": {
      "assistant_id": "hub",
      "input": {
        "service": "sb",
        "task": "word_example",
        "request_id": "sb-batch-20260812-1234",
        "payload": {
          "english": "prompt",
          "meaning": "신속한, 즉각적인"
        }
      }
    },
    "extension_rules": [
      "필드 추가는 선택(optional)으로만 - 필수 필드를 늘리면 기존 호출자가 그날 깨진다",
      "필드 삭제·의미 변경 금지 - 대신 새 task 를 만든다",
      "여분 필드는 무시된다 (호환 유지)"
    ]
  },
  "call_granularity": {
    "batch_request": {
      "supported": false,
      "description": "여러 단어를 한 요청에 담는 배치 API 는 없다. 한 요청 = 한 단어.",
      "reason": "실측 하루 6~17건(평균 11.1) 규모에서 배치로 아낄 것이 거의 없고, 잃는 것은 실재한다 - 개수·순서가 어긋나면 다른 단어에 저장되는 매핑 사고, 하나가 깨지면 전부 날아가는 실패 전파, 재생성용 API 를 따로 유지하는 비용.",
      "caller_guidance": "호출자가 단건 호출을 병렬 3~5개로 돌린다. 그 규모면 배치와 시간 차이가 없다.",
      "future": "하루 수백 건으로 늘면 배치 그래프를 추가한다. 그때도 단건은 유지한다 - 재생성이 쓴다."
    },
    "multiword_expression": {
      "supported": true,
      "description": "한 단어가 여러 낱말로 이루어진 경우(구동사·관용표현)는 정상 지원한다.",
      "verified_examples": [
        {
          "english": "put off",
          "example": "We had to put off our meeting until next week."
        },
        {
          "english": "run into",
          "example": "I run into my old friend at the store today."
        },
        {
          "english": "look after",
          "example": "Can you look after my cat this weekend?"
        },
        {
          "english": "once in a while",
          "example": "I visit my old friends once in a while."
        },
        {
          "english": "on purpose",
          "example": "Did you break it on purpose?"
        }
      ],
      "note": "구성 낱말이 문장에서 흩어져도 포함으로 인정한다 (put off -> put the meeting off)."
    }
