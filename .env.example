# 키 이름만 담는다. 값은 절대 넣지 않는다.
# 실제 값은 사용자가 .env 에 직접 채운다 (.env 는 git 미추적).

# --- LLM 프로바이더 ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- 그래프별 모델 ---
# `<GRAPH>_MODEL` 규약. init_chat_model 이 `openai:` / `anthropic:` 접두사로
# 프로바이더까지 바꾼다. 코드 변경 없이 .env 수정 + 재기동으로 교체된다.
# 시작은 openai:gpt-4.1-mini, 연산·사고가 무거운 그래프는 anthropic:claude-sonnet-* 로 승격.
# (그래프를 추가할 때 여기에 함께 등재한다)
